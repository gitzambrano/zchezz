tests/debug_*.py
tests/kqk_*.txt
tests/tb_test_*.txt

# Version-specific tournament scripts (one-off, not reusable)
tests/tournament_v*.py
tests/tournament_*_sf_*.py

# Deprecated test scripts (all replaced by run_tournament.py + run_tournament_quick.py)
tests/tournament_elo.py
tests/tournament_complete.py
tests/tb_tournament.py
tests/test_tournament.py
tests/match.py

# External engines (download separately)
engine/stockfish/
engine/stockfish_fast/
engine/maia/
engine/old/

# Deprecated engine versions (only latest kept in repo)
engine/c/zchezz_v2*/
engine/c/zchezz_v30[0-8]/

# Deprecated code
deprecated/

# Syzygy tablebases (938MB, download separately)
tablebases/

# Large data files (download separately)
endgames/
openings/
tests/suites/

# Utility binary files
utils/OpeningBook.bin

# Fathom library files (fetch from upstream)
engine/c/*/tbprobe.c
engine/c/*/tbprobe.h
engine/c/*/tbchess.c

# Build artifacts
*.exe
*.wasm
*.o
*.obj

# WASM build outputs (regenerated by build_wasm.bat / Makefile)
engine/c/*/zchezz_wasm.js

# Temp / debug files inside engine dirs
engine/c/*/_tb_test.txt
engine/c/*/stdin.txt
engine/c/*/check_offsets.*

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
*.code-workspace

# Regenerable test fixtures (tests/make_random_nnu4.py)
tests/random_nnu4*.bin
tests/*.selfplay.bin

# Shared build system (engine/build/) — binaries, wasm build outputs, and
# generated bundle. *.exe/*.wasm/*.o above already cover the binaries;
# these are the non-binary outputs (arena.exe/selfplay.exe land here now,
# not inside engine/c/zchezz_vXXX/ — see README.md, "engine/c/tools/").
engine/build/zchezz_bundle.html
engine/build/*.json
engine/build/*.pgn

# Arena/selfplay verification-run outputs (arena_run*.json,
# arena_nodes*.json, test_pgn_out.pgn, etc.) left inside an engine version
# folder by ad-hoc runs — these are never committed release artifacts.
engine/c/*/arena_run*.json
engine/c/*/arena_nodes*.json
engine/c/*/*.pgn
engine/c/*/test_pgn_out.pgn

# run_arena.py's ref: git-worktree build cache (fully reproducible from git)
.arena_build_cache/
engine/c/zchezz_v402/exe_backup/

# LC0 raw training-data downloads (import_lc0.py cache, ~200MB per tar)
data_raw/
# Professionalization artifacts
artifacts/
dist/
engine/c/zchezz_v*/zchezz_debug.exe
engine/c/zchezz_v*/zchezz_sanitize.exe
